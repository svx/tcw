---
import Layout from '../layouts/Layout.astro';

const year = new Date().getFullYear();
---

<Layout>
	<main
		class="relative isolate flex min-h-dvh flex-col overflow-hidden bg-linear-to-b from-stone-950 via-emerald-950 to-stone-950"
	>
		<!-- Decorative glow -->
		<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
			<div
				class="absolute top-1/4 left-1/2 size-[36rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/20 blur-3xl"
			>
			</div>
			<div class="absolute right-[-10rem] bottom-1/3 size-[24rem] rounded-full bg-amber-500/10 blur-3xl">
			</div>
		</div>

		<section class="flex flex-1 flex-col items-center justify-center px-6 py-24 text-center">
			<p class="mb-6 text-xs font-semibold tracking-[0.3em] text-emerald-300/80 uppercase sm:text-sm">
				Trail Running · Essen-Werden
			</p>

			<h1
				class="text-[clamp(2.75rem,9vw,6rem)] leading-[0.95] font-extrabold tracking-tight text-balance"
			>
				Trail Collective
				<span class="bg-linear-to-r from-emerald-300 to-amber-300 bg-clip-text text-transparent">
					Werden
				</span>
			</h1>

			<div
				class="mt-10 inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-stone-300 backdrop-blur"
			>
				<span class="relative flex size-2.5">
					<span
						class="absolute inline-flex size-full rounded-full bg-amber-400 opacity-75 motion-safe:animate-ping"
					></span>
					<span class="relative inline-flex size-2.5 rounded-full bg-amber-400"></span>
				</span>
				Coming soon
			</div>

			<p class="mt-8 max-w-xl text-2xl font-semibold text-stone-100 sm:text-3xl">
				Unsere neue Website kommt bald.
			</p>
			<p lang="en" class="mt-3 max-w-xl text-base text-stone-400 sm:text-lg">
				Our new website is coming soon.
			</p>
		</section>

		<!-- Decorative trail silhouette -->
		<svg
			aria-hidden="true"
			class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 w-full sm:h-64"
			viewBox="0 0 1440 320"
			preserveAspectRatio="none"
			fill="none"
		>
			<path
				d="M0 220 L180 130 L320 200 L500 90 L680 190 L860 110 L1040 200 L1220 120 L1440 210 V320 H0 Z"
				class="fill-emerald-900/40"></path>
			<path
				d="M0 260 L160 200 L340 250 L540 170 L720 240 L920 180 L1100 250 L1280 190 L1440 240 V320 H0 Z"
				class="fill-stone-950/80"></path>
			<path
				d="M-20 300 C 200 270, 360 310, 560 280 S 900 250, 1100 285 S 1340 300, 1460 270"
				class="stroke-amber-300/40"
				stroke-width="2"
				stroke-dasharray="6 10"
				stroke-linecap="round"></path>
		</svg>

		<footer class="relative px-6 pb-6 text-center text-xs text-stone-500">
			© {year} Trail Collective Werden
		</footer>
	</main>
</Layout>
