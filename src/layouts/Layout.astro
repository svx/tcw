---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Trail Collective Werden – Neue Website kommt bald',
	description = 'Trail Collective Werden – Trail Running in Essen-Werden. Unsere neue Website kommt bald. Our new website is coming soon.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0c0a09" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-dvh bg-stone-950 font-sans text-stone-100 antialiased">
		<slot />
	</body>
</html>
